{
  "schemaVersion": 1,
  "referenceConsumer": "canary-kit",
  "matrixDoc": "docs/signet-feature-matrix.md",
  "features": [
    {
      "id": "nip07",
      "label": "NIP-07 browser extension",
      "requiredForCanary": true,
      "projects": {
        "signetLogin": "covered",
        "canary": "covered",
        "mySignet": "not-applicable"
      },
      "gates": [
        { "type": "file", "path": "app/nostr/signet.test.ts" },
        { "type": "npmScript", "name": "test" },
        { "type": "workflow", "path": ".github/workflows/ci.yml", "contains": "npx vitest run --coverage" }
      ]
    },
    {
      "id": "amber",
      "label": "Amber / NIP-55",
      "requiredForCanary": false,
      "decision": "SDK covered, not exposed in Canary because Canary requires a live signer with NIP-44.",
      "projects": {
        "signetLogin": "sdk-covered",
        "canary": "sdk-covered",
        "mySignet": "not-applicable"
      },
      "gates": [
        { "type": "external", "repo": "signet-login", "command": "npm test", "description": "Amber URL/callback coverage lives in the SDK." }
      ]
    },
